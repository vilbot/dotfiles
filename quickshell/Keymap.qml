// Keyboard shortcuts model: quickshell/keymap.json, generated by keys/build.py from
// keys/keymap.toml (the source of truth). Shown by the Opt+? sheet (Keybinds.qml) and edited on
// the settings window's Shortcuts page (ShortcutsPage.qml).
// apply() saves through `keys/build.py --set <changes> --apply`: it edits keymap.toml, regenerates
// hypr/binds.lua + this json + KDE's shortcuts (used at the next KDE login), and puts keymap.toml
// back if the keys don't build (e.g. a key used twice). Then Hyprland reloads its config.
pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io

Singleton {
    id: root
    property var model: ({})
    readonly property var groups: model.groups ?? []
    readonly property int desktops: model.desktops ?? 0
    // the sheet shows only actions that have a key
    readonly property var boundGroups: groups.map(g => ({ title: g.title, rows: g.rows.filter(r => r.hyprLabel.length) }))
                                             .filter(g => g.rows.length)

    property bool busy: false
    property string error: ""          // the build's complaint, e.g. "opt+f is used twice on Hyprland: ..."
    property bool kdeChanged: false    // the last apply changed KDE's shortcuts (log out and in there)
    signal applied()

    FileView {
        path: Quickshell.shellDir + "/keymap.json"
        watchChanges: true
        onFileChanged: reload()
        onLoaded: {
            try { root.model = JSON.parse(text()) } catch (e) { console.warn("keymap.json:", e) }
        }
    }

    // changes: { action: { hypr: ["opt+p"], kde: null | [] | ["opt+x"] } }  (kde null = same as Hyprland)
    function apply(changes) {
        if (busy) return
        busy = true
        error = ""
        proc.command = ["sh", "-c",
            'root=$(readlink -f "$1")/..; out=$(python3 "$root/keys/build.py" --apply --set "$2" 2>&1); code=$?; ' +
            '[ $code = 0 ] && hyprctl reload >/dev/null; printf "%s\\n%s" "$code" "$out"',
            "sh", Quickshell.shellDir, JSON.stringify(changes)]
        proc.running = true
    }

    Process {
        id: proc
        stdout: StdioCollector {
            onStreamFinished: {
                const lines = text.split("\n")
                const out = lines.slice(1).join("\n").trim()
                root.busy = false
                if (lines[0] === "0") {
                    root.kdeChanged = /^set\s/m.test(out)
                    root.applied()
                } else {
                    root.error = out.split("\n").pop() || "couldn't save"
                }
            }
        }
    }
}
