window-width = 120
window-height = 30

quick-terminal-position = center
quick-terminal-size = 50%, 50%

macos-titlebar-style = tabs
gtk-titlebar-style = tabs
# Draw our own (GTK) titlebar with the tabs; stops KDE/KWin from adding a second one.
# No effect on macOS.
window-decoration = client

font-family = "Hack"
font-thicken = true
font-thicken-strength = 100
font-size = 12
adjust-cell-height = 35%
# Resolved from ~/.config/ghostty/themes/ (this repo's ghostty/themes via the symlink)
theme = gruver16
mouse-hide-while-typing = true

keybind = super+shift+w=ignore
