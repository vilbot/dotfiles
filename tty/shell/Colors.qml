// generated by theme/build.py from theme/gruver16.yaml; do not edit
// None's current theme (~/.local/state/none/theme.json, written by tty/theme.py), read again
// when it changes, so everything drawn with these changes with it; gruver16 until one is picked.
pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io

Singleton {
    id: root
    property var theme: ({})
    readonly property bool light: theme.variant === "light"
    FileView {
        path: (Quickshell.env("XDG_STATE_HOME") || Quickshell.env("HOME") + "/.local/state") + "/none/theme.json"
        watchChanges: true
        onFileChanged: reload()
        // a file caught half-written doesn't parse: the last good one stays
        onLoaded: { try { const t = JSON.parse(text()); if (t.base00) root.theme = t } catch (e) {} }
    }
    readonly property color base00: theme.base00 ?? "#282828"
    readonly property color base01: theme.base01 ?? "#333438"
    readonly property color base02: theme.base02 ?? "#3e4148"
    readonly property color base03: theme.base03 ?? "#4a4f59"
    readonly property color base04: theme.base04 ?? "#565c6a"
    readonly property color base05: theme.base05 ?? "#999eac"
    readonly property color base06: theme.base06 ?? "#c3c4ca"
    readonly property color base07: theme.base07 ?? "#ede9e8"
    readonly property color base08: theme.base08 ?? "#fb4833"
    readonly property color base09: theme.base09 ?? "#9e95c7"
    readonly property color base0A: theme.base0A ?? "#95a99f"
    readonly property color base0B: theme.base0B ?? "#8fbf7f"
    readonly property color base0C: theme.base0C ?? "#b3ccc0"
    readonly property color base0D: theme.base0D ?? "#96a6c8"
    readonly property color base0E: theme.base0E ?? "#d8a657"
    readonly property color base0F: theme.base0F ?? "#a5765c"
}
