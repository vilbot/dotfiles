#!/usr/bin/env bash
# Apps that need a terminal (Terminal=true, like yazi) open in the "None" desktop's console
# terminal. GLib (gtk-launch, file managers) runs xdg-terminal-exec when it's on PATH, and
# tty/hyprland.lua puts this folder first on PATH only in that desktop.
# Except the updater (cachy-update's "Run Cachy-Update", its app entry): it runs in the settings
# panel's update tab, where it goes on when the panel closes (tty/panel/update.py).
[[ ${1:-} == -e || ${1:-} == -- ]] && shift
tty=$(dirname "$(readlink -f "$0")")/..
if [[ $# -eq 1 && ${1##*/} =~ ^(arch-update|cachy-update)$ ]]; then
    "$tty/panel/update.py" start
    exec "$tty/panel.sh" open update
fi
exec "$tty/term" "$@"
