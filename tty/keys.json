{
  "about": "None's keys. Desktop keys are Hyprland binds (tty/binds.lua, actions in tty/actions.lua), written the way Hyprland writes them: SUPER, CTRL, ALT, SHIFT + a key named as on the US layout (H, 1, Return, Escape, space, slash, F5). {n} = desktops 1..N, {dir} = H J K L, {arrow} = the arrow keys. apps = the launcher's and the Settings app's own keys (tty/shell/AppKeys.qml). Edited by hand or on the Settings app's Shortcuts page; saving there reloads Hyprland.",
  "desktops": 5,
  "sections": [
    { "title": "Desktops", "actions": {
      "desktop.goto.{n}": { "keys": ["SUPER + {n}"], "label": "Go to desktop" },
      "desktop.prev": { "keys": ["SUPER + SHIFT + Tab"], "label": "Previous desktop" },
      "desktop.next": { "keys": ["SUPER + Tab"], "label": "Next desktop" },
      "desktop.last": { "keys": [], "label": "Desktop you were on before" },
      "desktop.move.{n}": { "keys": ["ALT + SHIFT + {n}"], "label": "Send window to desktop" },
      "desktop.take.{n}": { "keys": [], "label": "Take window to desktop" },
      "desktop.move.prev": { "keys": [], "label": "Send window to previous desktop" },
      "desktop.move.next": { "keys": [], "label": "Send window to next desktop" },
      "scratchpad.toggle": { "keys": [], "label": "Show / hide scratchpad" },
      "scratchpad.move": { "keys": [], "label": "Send window to scratchpad" }
    } },
    { "title": "Windows", "actions": {
      "window.focus.{dir}": { "keys": ["SUPER + {dir}"], "label": "Focus window" },
      "window.move.{dir}": { "keys": ["SUPER + SHIFT + {dir}"], "label": "Move window" },
      "window.swap.{dir}": { "keys": [], "label": "Swap with window" },
      "window.resize.{dir}": { "keys": ["SUPER + CTRL + {dir}"], "label": "Resize window", "repeat": true },
      "window.close": { "keys": ["SUPER + Q"], "label": "Close window" },
      "window.fullscreen": { "keys": ["SUPER + F"], "label": "Fullscreen" },
      "window.maximize": { "keys": [], "label": "Maximize" },
      "window.float": { "keys": ["SUPER + SHIFT + F"], "label": "Floating" },
      "window.pin": { "keys": [], "label": "Pin floating window" },
      "window.center": { "keys": [], "label": "Center floating window" },
      "window.split": { "keys": [], "label": "Turn split sideways / up-down" }
    } },
    { "title": "Tab groups", "actions": {
      "group.toggle": { "keys": ["SUPER + M"], "label": "Make / undo a tab group" },
      "group.next": { "keys": ["SUPER + N"], "label": "Next tab" },
      "group.prev": { "keys": ["SUPER + P"], "label": "Previous tab" }
    } },
    { "title": "Clipboard", "actions": {
      "clipboard.copy": { "keys": ["SUPER + C"], "label": "Copy, in any app" },
      "clipboard.paste": { "keys": ["SUPER + V"], "label": "Paste, in any app" },
      "clipboard.cut": { "keys": ["SUPER + X"], "label": "Cut, in any app" }
    } },
    { "title": "Launch & type", "actions": {
      "launcher": { "keys": ["SUPER + space"], "label": "Launcher" },
      "terminal": { "keys": ["SUPER + Return"], "label": "Terminal" },
      "settings": { "keys": [], "label": "Settings" },
      "layout.next": { "keys": ["ALT + space"], "label": "Switch keyboard layout" },
      "screenshot.region": { "keys": ["SUPER + SHIFT + 4"], "label": "Screenshot key: drag an area" }
    } },
    { "title": "Function keys", "actions": {
      "brightness.down": { "keys": ["F1"], "label": "Brightness down", "repeat": true },
      "brightness.up": { "keys": ["F2"], "label": "Brightness up", "repeat": true },
      "panel.control": { "keys": ["F5"], "label": "Control center" },
      "appearance.toggle": { "keys": ["F6"], "label": "Dark / light mode" },
      "media.back": { "keys": ["F7"], "label": "Back 5 seconds" },
      "media.playpause": { "keys": ["F8"], "label": "Play / pause" },
      "media.forward": { "keys": ["F9"], "label": "Forward 5 seconds" },
      "volume.mute": { "keys": ["F10"], "label": "Mute" },
      "volume.down": { "keys": ["F11"], "label": "Volume down", "repeat": true },
      "volume.up": { "keys": ["F12"], "label": "Volume up", "repeat": true }
    } },
    { "title": "Session", "actions": {
      "help.keys": { "keys": ["ALT + SHIFT + slash"], "label": "Keyboard shortcuts (Settings)" },
      "session.reload": { "keys": [], "label": "Reload Hyprland config" },
      "session.exit": { "keys": ["ALT + SHIFT + Escape"], "label": "Log out" },
      "session.lock": { "keys": ["SUPER + CTRL + Q"], "label": "Lock" },
      "session.sleep": { "keys": [], "label": "Sleep" }
    } }
  ],
  "apps": {
    "launcher": { "title": "Launcher", "actions": {
      "launcher.run": { "keys": ["Return", "KP_Enter"], "label": "Start the pick (or run what's typed)" },
      "launcher.close": { "keys": ["Escape"], "label": "Close (on an empty desktop: clear)" },
      "launcher.next": { "keys": ["Down", "CTRL + J"], "label": "Next result" },
      "launcher.prev": { "keys": ["Up", "SHIFT + Tab", "CTRL + K"], "label": "Previous result" },
      "launcher.complete": { "keys": ["Tab"], "label": "Complete" },
      "launcher.take": { "keys": ["Right"], "label": "At the end of the text: take the dimmed suggestion" },
      "launcher.favorite": { "keys": ["CTRL + F"], "label": "Add / remove a favorite" },
      "launcher.clear": { "keys": ["CTRL + C"], "label": "Erase what's typed (text selected: copies)" },
      "launcher.window": { "keys": ["CTRL + N"], "label": "On a Chrome row: in a new window" },
      "launcher.incognito": { "keys": ["CTRL + SHIFT + N"], "label": "On a Chrome row: in a new incognito window" }
    } },
    "settings": { "title": "Settings", "actions": {
      "settings.next": { "keys": ["Down", "J"], "label": "Next row" },
      "settings.prev": { "keys": ["Up", "K"], "label": "Previous row" },
      "settings.activate": { "keys": ["Return"], "label": "Change the row (Shortcuts: record keys)" },
      "settings.add": { "keys": ["A"], "label": "Shortcuts: record one more key" },
      "settings.unbind": { "keys": ["BackSpace", "Delete"], "label": "Shortcuts: remove the row's keys" },
      "settings.search": { "keys": ["slash", "CTRL + F"], "label": "Search" },
      "settings.back": { "keys": ["Escape"], "label": "Leave the search; again: clear it" },
      "settings.page.next": { "keys": ["Tab"], "label": "Next page" },
      "settings.page.prev": { "keys": ["SHIFT + Tab"], "label": "Previous page" },
      "settings.lower": { "keys": ["Left", "H"], "label": "Slider down, previous choice" },
      "settings.higher": { "keys": ["Right", "L"], "label": "Slider up, next choice" },
      "settings.undo": { "keys": ["CTRL + Z"], "label": "Undo" },
      "settings.redo": { "keys": ["CTRL + SHIFT + Z"], "label": "Redo" },
      "settings.close": { "keys": ["CTRL + W"], "label": "Close" }
    } }
  },
  "notes": {
    "Windows": [["Move window with mouse", "Super drag"], ["Resize window with mouse", "Super right-drag"]],
    "Function keys": [["The plain F-key, for apps", "AltGr (right Alt) + F-key"]]
  }
}
