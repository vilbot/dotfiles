#!/usr/bin/env bash
# Locks None: hyprlock with tty/hyprlock.conf (only your password opens it). Ctrl+Cmd+Q, the
# launcher's "Lock", zsh's `lock`, and before sleep (tty/hypridle.conf). Locking twice does nothing.
tty=$(dirname "$(readlink -f "$0")")
pidof -q hyprlock && exit 0
python3 "$tty/theme.py" ensure   # the colours it sources (~/.local/state/none/hyprlock-colors.conf)
exec hyprlock -c "$tty/hyprlock.conf" "$@"
