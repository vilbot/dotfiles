#!/usr/bin/env bash
# Your session from boot (greetd's initial_session, tty/login.sh): None, locked, behind its login
# form (tty/shell/LockScreen.qml). Opening it is unlocking, so there's no black in between.
# Picking Hyprland or KDE in the form ends None; this starts that one, and None (locked) again
# when you log out of it. If desktops keep dying right away, this gives up and greetd shows its
# login screen (tty/greeter) instead.
# Everything this and the desktops print goes to the journal (journalctl -t none-session), not to
# tty1: the first visible text on tty1 makes the kernel's console take over the screen and draw
# what boot left there, for a moment, between the boot splash and None.
exec > >(exec systemd-cat -t none-session) 2>&1
tty=$(dirname "$(readlink -f "$0")")
run=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
next=$run/tty-next   # the form writes the desktop to start here

exec_of() {   # the command greetd's session list has for a desktop
    sed -n 's/^Exec=//p' /etc/greetd/sessions/*-"${1,,}".desktop 2>/dev/null | head -1
}

# Between desktops: what the last one left in your session (its programs, and the variables
# it gave systemd and D-Bus, e.g. which Wayland display to use) goes, so the next one starts
# as if you had just logged in. Each desktop sets its own again when it starts.
SESSION_VARS=(WAYLAND_DISPLAY DISPLAY HYPRLAND_INSTANCE_SIGNATURE XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP
              QT_QPA_PLATFORMTHEME XDG_MENU_PREFIX GSK_RENDERER KDE_SESSION_VERSION DESKTOP_SESSION)
clean() {
    pkill -f "^qs -p $tty/shell" 2>/dev/null       # None's bar (ends with its screen anyway)
    pkill -x hypridle 2>/dev/null
    systemctl --user stop mackeys.service 2>/dev/null   # Hyprland's keys; the full Hyprland starts it again
    systemctl --user unset-environment "${SESSION_VARS[@]}"
    dbus-update-activation-environment "${SESSION_VARS[@]/%/=}" 2>/dev/null   # D-Bus can't unset: empty
}

quick=0
echo None >"$next"
while :; do
    desktop=$(cat "$next" 2>/dev/null)
    rm -f "$next"
    clean
    started=$SECONDS
    case $desktop in
        Hyprland|KDE) cmd=$(exec_of "$desktop"); [[ -n $cmd ]] && sh -c "$cmd" ;;
        *) echo locked >"$run/tty-locked"; "$tty/start" ;;
    esac
    [[ -s $next ]] || echo None >"$next"
    if (( SECONDS - started < 5 )); then
        (( ++quick >= 3 )) && exit 1
    else
        quick=0
    fi
done
